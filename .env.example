# ==============================================================================
# SMBify Lead OS — Environment Configuration Template
# Copy this file to '.env' and set your real values before deploying.
# Never commit your real '.env' file containing secrets to version control!
# ==============================================================================

# Server Port (Default: 5050)
PORT=5050

# Database Storage Path
DATABASE_PATH=./db/smbify_lead_os.db

# Allowed CORS Origins (Comma-separated URLs)
# In production, replace with your actual domain e.g. https://smbifyos.app
# NEVER use wildcard '*' in production when credentials/auth are enabled!
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Scraper Output Directory
SCRAPER_OUTPUT_DIR=./db/scraper-output

# JWT Secret Key for Session Authentication (Must be a 64+ char random hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_with_random_32_bytes_hex_string

# Secret Key for Encrypting Database Credentials at Rest (Must be 32 bytes / 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=generate_with_random_32_bytes_hex_string

# Proxy Bypass Hosts
SCRAPER_PROXY_BYPASS=localhost,127.0.0.1
